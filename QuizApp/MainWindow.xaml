<Window x:Class="QuizApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizApp"
        Height="500"
        Width="800"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="QuizApp"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Content="Open Quiz"
                    Command="{Binding OpenQuizCommand}"
                    Padding="16,8"
                    Margin="16,0,0,0"
                    DockPanel.Dock="Right"/>
            <Button Content="Create Quiz"
        Command="{Binding CreateQuizCommand}"
        Padding="12,7"
        Margin="4"/>

            <Button Content="Edit Quiz"
        Command="{Binding EditQuizCommand}"
        Padding="12,7"
        Margin="4"/>
        </DockPanel>

        <!-- Main content -->
        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="{Binding QuizTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

                <UniformGrid Columns="2"
                             Margin="0,32,0,0">

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Questions"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding QuestionCount}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="Duration"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding DurationDisplay}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                       
                    </StackPanel>
                   
                </UniformGrid>
                <Button Content="Start Quiz"
Command="{Binding StartQuizCommand}"
Padding="24,12"
FontSize="16"
FontWeight="SemiBold"
/>
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Margin="0,32,0,0"
                             Visibility="{Binding IsBusy,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="Gray"
                   Margin="0,16,0,0"
                   VerticalAlignment="Center"/>

    </Grid>
</Window>
