<Window x:Class="QuizApp.Desktop.Views.QuizEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:QuizApp.Domain.Enums;assembly=QuizApp.Domain"
        xmlns:vm="clr-namespace:QuizApp.Desktop.ViewModels.Editor"
        Title="Quiz Editor"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="550"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <x:Array x:Key="QuestionTypes"
                 Type="{x:Type enums:QuestionType}">
            <enums:QuestionType>SingleChoice</enums:QuestionType>
            <enums:QuestionType>MultipleChoice</enums:QuestionType>
        </x:Array>

        <DataTemplate DataType="{x:Type vm:EditorQuestionViewModel}">
            <StackPanel Margin="20">

                <TextBlock Text="Question content"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding Content,
                                        UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="90"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8"/>

                <Grid Margin="0,16,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Question type"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{StaticResource QuestionTypes}"
                                  SelectedItem="{Binding Type}"
                                  Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Points"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Points}"
                                 Padding="6"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,16"/>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Options"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Content="+ Add option"
                            Command="{Binding AddOptionCommand}"
                            DockPanel.Dock="Right"
                            Padding="12,5"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,0,8">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Content="Correct"
                                              IsChecked="{Binding IsCorrect}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding Content,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             Padding="6"/>

                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            Command="{Binding DataContext.RemoveOptionCommand,
                                                RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Margin="12,0,0,0"
                                            Padding="8,5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel: quiz metadata and question list -->
        <Border Grid.Column="0"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Quiz information"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Title"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding Title,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Padding="7"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="0,12,0,16">
                    <TextBlock Text="Duration (seconds)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding DurationSeconds}"
                             Padding="7"/>
                </StackPanel>

                <DockPanel Grid.Row="3">
                    <TextBlock Text="Questions"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               DockPanel.Dock="Top"/>

                    <ListBox ItemsSource="{Binding Questions}"
                             SelectedItem="{Binding SelectedQuestion}"
                             BorderThickness="0">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9"
                                        Margin="0,0,0,5"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="4">

                                    <TextBlock Text="{Binding Content,
                                                              TargetNullValue='New question'}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Grid Grid.Row="4"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="+ Add question"
                            Command="{Binding AddQuestionCommand}"
                            Padding="8,7"/>

                    <Button Grid.Column="2"
                            Content="Remove"
                            Command="{Binding RemoveQuestionCommand}"
                            CommandParameter="{Binding SelectedQuestion}"
                            Padding="8,7"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Right panel: selected question editor -->
        <Border Grid.Column="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding SelectedQuestion}"/>
                </ScrollViewer>

                <TextBlock Text="Select a question or add a new one to begin editing."
                           Foreground="Gray"
                           FontSize="15"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedQuestion}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>