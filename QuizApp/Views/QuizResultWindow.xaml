<Window x:Class="QuizApp.Desktop.Views.QuizResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Results"
        Height="750"
        Width="1000"
        MinHeight="600"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding QuizTitle}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#202124"/>

            <TextBlock Text="{Binding CompletionStatus}"
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Score summary -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="24"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Score"
                               Foreground="#777777"
                               FontSize="14"/>

                    <TextBlock Text="{Binding ScoreDisplay}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#2563EB"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Correct answers"
                               Foreground="#777777"
                               FontSize="14"/>

                    <TextBlock Text="{Binding CorrectAnswersDisplay}"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Points"
                               Foreground="#777777"
                               FontSize="14"/>

                    <TextBlock Text="{Binding PointsDisplay}"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Question review -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Questions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="White"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,14">

                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">

                                    <TextBlock Text="{Binding StatusText}"
           DockPanel.Dock="Right"
           FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding DisplayNumber,
                                        StringFormat=Question {0}}"
                                               FontSize="17"
                                               FontWeight="Bold"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Content}"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10"
                                                    CornerRadius="5"
                                                    Margin="0,3"
                                                    BorderThickness="1"
                                                    BorderBrush="#DDDDDD">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Content}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal">

                                                        <TextBlock Text="Your choice"
                                                                   Foreground="#2563EB"
                                                                   Margin="8,0"
                                                                   Visibility="{Binding IsSelected,
                                                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                        <TextBlock Text="Correct"
                                                                   Foreground="#16A34A"
                                                                   FontWeight="Bold"
                                                                   Margin="8,0"
                                                                   Visibility="{Binding IsCorrect,
                                                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding EarnedPoints,
                                    StringFormat=Points earned: {0:0.##}}"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
